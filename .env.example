# ================================================================
# NEXUS AI ENVIRONMENT CONFIGURATION
# ================================================================

# Port for local Express backend server (default: 5000)
PORT=5000

# Secure cryptographic secret for signing JSON Web Tokens (JWT)
# IMPORTANT: In production, generate a strong, random 64-character secret
JWT_SECRET=nexus_ai_super_secret_jwt_key_2026_production_grade_32byte_string

# Google Gemini AI API Key for multimodal model reasoning (Optional for local brain fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Model Identifier
DEFAULT_AI_MODEL=gemini-1.5-flash

# Environment Mode: 'development' | 'production'
NODE_ENV=development
