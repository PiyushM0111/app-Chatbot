# Server Port
PORT=5000

# JWT Secret for User Session Signing
JWT_SECRET=super_secret_jwt_key_chatbot_secure_2026

# Google Gemini API Key (Get your key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Model (options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
DEFAULT_AI_MODEL=gemini-1.5-flash
